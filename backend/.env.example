# App
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/safar

# Auth
JWT_SECRET=your-jwt-secret-change-in-prod
JWT_EXPIRES_IN=30d

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS S3 (File Uploads)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=safar-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (Email — Gmail/Resend/any SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Safar" <noreply@safar.in>

# Firebase (Push Notifications — optional, degrades gracefully)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MSG91 (SMS — optional, degrades gracefully)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SAFAR
MSG91_ROUTE=4
MSG91_TPL_BOOKING_CONFIRMED=
MSG91_TPL_RIDE_STARTED=
MSG91_TPL_RIDE_COMPLETED=
MSG91_TPL_BOOKING_CANCELLED=
